# ============================================================
#  TEAM VERITAS — configuration
#  Copie ce fichier en `.env.local` puis remplis les valeurs.
#  NE COMMITTE JAMAIS `.env.local`.
# ============================================================

# --- Paiement Solana ---------------------------------------
# Réseau : "devnet" pour tester (SOL de test, gratuit), "mainnet-beta" pour de l'argent réel.
# ⚠️ Reste sur devnet tant que tu n'as pas testé de bout en bout.
SOLANA_NETWORK=devnet

# (optionnel) URL RPC custom. Les RPC publics par défaut sont lents/limités ;
# pour la prod utilise un fournisseur (Helius, QuickNode, Triton...).
# SOLANA_RPC_URL=https://api.devnet.solana.com

# Ton adresse Solana qui RECOIT les paiements (adresse marchand).
MERCHANT_WALLET=HMvrkW1sAkhVDGHCpudLbSQjvrGWE3qtyqmyVZzhDEHm

# Prix en euros. Le montant en SOL est calculé au cours du moment.
PRICE_EUR=200

# --- Accès ------------------------------------------------
# Code d'accès pour atteindre la page de paiement (early access / privé).
# Laisse vide pour désactiver la protection par code.
ACCESS_CODE=NX0345CG

# --- Livraison --------------------------------------------
# Secret pour signer les liens de téléchargement à usage unique.
# Génère-le avec :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOWNLOAD_SECRET=change-moi-avec-un-secret-aleatoire-de-32-octets

# Chemin ABSOLU ou relatif vers le fichier du jeu à livrer.
# ⚠️ Doit être HORS du dossier /public (sinon il serait téléchargeable sans payer).
GAME_FILE_PATH=./protected/jeu.zip
# Nom du fichier proposé au téléchargement.
GAME_FILE_NAME=team-veritas-jeu.zip

# --- Vitrine ----------------------------------------------
GAME_NAME=NOM DU JEU
